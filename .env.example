# Copier ce fichier vers .env et adapter les valeurs (jamais commiter .env)

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite par défaut (dev). En prod, pointer vers PostgreSQL, ex:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Chemin de l'exécutable npm (utilisé par django-tailwind en dev, optionnel si npm est dans le PATH)
# NPM_BIN_PATH=C:\path\to\npm.cmd
